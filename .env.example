# Базовый URL Tinkoff Invest API (REST-шлюз).
# ОБЯЗАТЕЛЬНО задать в окружении, включая Vercel (Project → Settings →
# Environment Variables). Без него baseURL axios = undefined и все вызовы
# к Tinkoff падают с 500.
TINKOFF_URL=https://invest-public-api.tinkoff.ru/rest

# Порт локального dev-сервера. На Vercel не нужен (платформа задаёт свой).
PORT=5050
